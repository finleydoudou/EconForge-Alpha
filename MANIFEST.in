include README.md LICENSE THIRD_PARTY_NOTICES.txt requirements-p32.txt CONTRIBUTING.md
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include schemas *.json
recursive-include src/econforge *.py *.json *.md
prune tests
prune artifacts
prune validation
prune tools
prune .github
global-exclude __pycache__ *.py[cod] .DS_Store
